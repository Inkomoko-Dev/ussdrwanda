# Copy to .env and adjust. .env is not committed.
# Compose uses the host network, so localhost is Postgres on your machine
# (Windows, macOS, and Linux). The same values work for ./mvnw spring-boot:run.

DB_URL=jdbc:postgresql://localhost:5432/inkomoko_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Customer and loan data comes from the Inkomoko Omnichannel API (staging).
# Ask the team for the secret; never commit it.
OMNICHANNEL_BASE_URL=http://dev.inkomoko.com:1134/api/v1
OMNICHANNEL_API_KEY=fdi
OMNICHANNEL_SECRET=
# Pilot: "Mark as paid" and auto-completion of pushed repayments via Omnichannel manual-success
# (no telecom debit). Keep in step with Omnichannel; set false once their telecom side is live.
OMNICHANNEL_MANUAL_SUCCESS_ENABLED=true
