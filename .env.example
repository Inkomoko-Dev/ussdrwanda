# Copy to .env and fill in secrets. .env is not committed.
#
# Local / Maven: DB_URL + Omnichannel staging.
# Production (docker-compose.prod.yml): use DB_HOST/DB_* + JWT_SECRET + Omnichannel prod.
#   docker compose --env-file .env -f docker-compose.prod.yml up --build -d

# ── Database ──────────────────────────────────────────────────────────────
# Local:
DB_URL=jdbc:postgresql://localhost:5432/inkomoko_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Production compose (external Postgres; ignored by local ./mvnw if you only set DB_URL):
# DB_HOST=10.0.0.4
# DB_PORT=5432
# DB_NAME=inkomoko_db

# ── Portal JWT (required for docker-compose.prod.yml — at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ── Omnichannel (core banking + MoMo) ─────────────────────────────────────
OMNICHANNEL_BASE_URL=http://dev.inkomoko.com:1134/api/v1
OMNICHANNEL_API_KEY=fdi
OMNICHANNEL_SECRET=
# Pilot only — set false when telecom debit is live:
OMNICHANNEL_MANUAL_SUCCESS_ENABLED=true

# ── Production extras (uncomment on the prod server) ──────────────────────
# APP_PORT=8093
# USSD_SERVICE_CODE=311
# FINERACT_MODE=omnichannel
# PAYMENT_MODE=omnichannel
# SMS_MODE=live
# SMS_BASE_URL=
# SMS_API_KEY=
# SUPPORT_HELPLINE=+250788683998
